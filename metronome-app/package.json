{
  "name": "metronome",
  "private": true,
  "version": "2.0.0",
  "description": "A multi-metre metronome for complex music: build a map of bars, metres and tempi, share it as a URL, and play it with a sample-accurate audio engine and rolling display.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "deploy:site": "vite build --outDir ../metronome2 --emptyOutDir"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pocketbase": "^0.28.1",
    "qrcode-generator": "^2.0.4"
  }
}
